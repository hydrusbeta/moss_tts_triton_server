name: "moss_tts"
backend: "python"
max_batch_size: 0

input [
  {
    name: "text"
    data_type: TYPE_STRING
    dims: [1]
  },
  {
    name: "n_vq"
    data_type: TYPE_UINT16
    dims: [1]
  },
  {
    name: "audio_temperature"
    data_type: TYPE_FP32
    dims: [1]
  },
  {
    name: "audio_top_p"
    data_type: TYPE_FP32
    dims: [1]
  },
  {
    name: "audio_top_k"
    data_type: TYPE_UINT16
    dims: [1]
  },
  {
    name: "repetition_penalty"
    data_type: TYPE_UINT16
    dims: [1]
  },
  {
    name: "speaker_id"
    data_type: TYPE_UINT16
    dims: [1]
  },
  {
    name: "language"
    data_type: TYPE_STRING
    dims: [1]
  },
  {
    name: "emotion_id"
    data_type: TYPE_UINT16
    dims: [1]
  },
  {
    name: "emotion_energy"
    data_type: TYPE_FP32
    dims: [1]
  },
  {
    name: "max_new_tokens"
    data_type: TYPE_UINT16
    dims: [1]
  }
]
output [
  {
    name: "audio"
    data_type: TYPE_INT16
    dims: [1]
  }
]
instance_group [
  {
    count: 1
    kind: KIND_CPU
  }
]
